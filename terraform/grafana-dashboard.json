{
  "uid": "todo-capstone-overview",
  "title": "Capstone Todo Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "EKS Nodes Ready",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"})" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Running App Pods (Staging + Prod)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "count(kube_pod_status_phase{namespace=~\"staging|prod\",phase=\"Running\"} == 1)" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "App Pod Restarts (1h)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=~\"staging|prod\"}[1h])) or vector(0)" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Cluster CPU Used %",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1 } },
      "targets": [{ "refId": "A", "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100)" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "App Pod CPU (Staging & Prod)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "refId": "A",
        "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=~\"staging|prod\",container!=\"\",container!=\"POD\"}[2m])) by (namespace, pod)",
        "legendFormat": "{{namespace}}/{{pod}}"
      }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "App Pod Memory (MB)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "decmbytes" } },
      "targets": [{
        "refId": "A",
        "expr": "sum(container_memory_working_set_bytes{namespace=~\"staging|prod\",container!=\"\",container!=\"POD\"}) by (namespace, pod) / 1024 / 1024",
        "legendFormat": "{{namespace}}/{{pod}}"
      }]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Node Memory Used %",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "targets": [{
        "refId": "A",
        "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
        "legendFormat": "{{instance}}"
      }]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Running Pods by Namespace",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "refId": "A",
        "expr": "count(kube_pod_status_phase{phase=\"Running\"} == 1) by (namespace)",
        "legendFormat": "{{namespace}}"
      }]
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Live App Logs (Loki: Staging & Prod)",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 9 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "refId": "A", "expr": "{namespace=~\"staging|prod\"}" }]
    }
  ]
}
